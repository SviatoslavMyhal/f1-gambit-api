PORT=3000
DB_HOST=localhost
# With `docker compose up postgres` use 5434 (see docker-compose; host :5432 is often busy).
DB_PORT=5434
DB_USER=gambit
DB_PASSWORD=gambit
DB_NAME=gambit
USE_SSL=false
MIGRATIONS_RUN_ON_START=false
DB_SECRET_ARN=

REDIS_HOST=localhost
# With `docker compose up redis` use 6380 (see docker-compose; host :6379 is often busy).
REDIS_PORT=6380

# Head-to-head grid size for SimulationEngine (2–22, default 20)
MULTIPLAYER_GRID_SIZE=20
